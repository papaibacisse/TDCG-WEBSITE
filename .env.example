# ─── TDCG website — environment variables ───────────────────────────────
# Copy this file to .env.local and fill in real values before deploying.

# Public site URL (used for canonical tags, Open Graph, sitemap generation)
NEXT_PUBLIC_SITE_URL=https://terangadigitalconsultinggroup.com

# Contact email used by the mailto:// fallbacks on the audit / devis / contact forms
NEXT_PUBLIC_CONTACT_EMAIL=contact@terangadigitalconsultinggroup.com

# WhatsApp numbers (E.164, no spaces) used by the floating WhatsApp menu
NEXT_PUBLIC_WHATSAPP_NUMBER_1=221772554422
NEXT_PUBLIC_WHATSAPP_NUMBER_2=221761835379

# ─── Analytics & tracking (only loaded after cookie consent is granted) ──
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_CONTAINER_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_INSIGHT_ID=

# ─── Forms backend (optional) ────────────────────────────────────────────
# If you wire the audit/devis/contact forms to a real backend or a service
# like Resend, Formspree, or a serverless API route, put the endpoint/key here.
FORM_SUBMISSION_ENDPOINT=
FORM_SUBMISSION_API_KEY=
